import java_cup.runtime.*;

parser code {:
    public void syntax_error(Symbol s) {
        System.err.println("Erro de Sintaxe na linha " + s.left + 
                           ", coluna " + s.right + 
                           ". Token nao esperado: '" + s.value + "'");
    }
:};

terminal AVANCE, VIRE, LEIASENSOR, SE, ENTAO, ENQUANTO, FUNCAO, RETORNE, INICIO, FIM;
terminal INTEIRO, LOGICO, PONTO, MAIS, MENOS, MULT, DIV, IGUAL, DIFERENTE, MENOR, MAIOR, ATRIBUICAO;
terminal PONTOVIRGULA, APARENTESES, FPARENTESES, ACHAVES, FCHAVES;
terminal String ID, NUMERO, TEXTO;

non terminal programa, lista_comandos, comando;
non terminal cmd_movimento, cmd_condicional, cmd_repeticao, declaracao, atribuicao, expressao;

precedence left MAIS, MENOS;
precedence left MULT, DIV;
precedence left IGUAL, DIFERENTE, MENOR, MAIOR;

programa ::= lista_comandos 
             {: System.out.println("\n[Sintático] => ANALISE CONCLUIDA COM SUCESSO! Programa valido.\n"); :} ;

lista_comandos ::= lista_comandos comando 
                 | comando ;

comando ::= declaracao PONTOVIRGULA
          | atribuicao PONTOVIRGULA
          | cmd_movimento PONTOVIRGULA
          | cmd_condicional
          | cmd_repeticao
          | error PONTOVIRGULA ; 

declaracao ::= INTEIRO ID 
             {: System.out.println("[Sintático] Regra aplicada: Declaracao de variavel INTEIRA."); :}
             | LOGICO ID 
             {: System.out.println("[Sintático] Regra aplicada: Declaracao de variavel LOGICA."); :}
             | PONTO ID 
             {: System.out.println("[Sintático] Regra aplicada: Declaracao de variavel PONTO."); :} ;

atribuicao ::= ID ATRIBUICAO expressao 
             {: System.out.println("[Sintático] Regra aplicada: Atribuicao de valor a uma variavel."); :}
             | ID ATRIBUICAO LEIASENSOR APARENTESES FPARENTESES 
             {: System.out.println("[Sintático] Regra aplicada: Leitura de sensor salva na variavel."); :} ;

cmd_movimento ::= AVANCE APARENTESES expressao FPARENTESES
                {: System.out.println("[Sintático] Regra aplicada: Comando de MOVIMENTO (Avance)."); :}
                | VIRE APARENTESES TEXTO FPARENTESES 
                {: System.out.println("[Sintático] Regra aplicada: Comando de MOVIMENTO (Vire)."); :} ;

cmd_condicional ::= SE APARENTESES expressao FPARENTESES ENTAO lista_comandos FIM PONTOVIRGULA 
                  {: System.out.println("[Sintático] Regra aplicada: Estrutura CONDICIONAL (se...entao) finalizada."); :} ;

cmd_repeticao ::= ENQUANTO APARENTESES expressao FPARENTESES lista_comandos FIM PONTOVIRGULA 
                {: System.out.println("[Sintático] Regra aplicada: Estrutura de REPETICAO (enquanto) finalizada."); :} ;

expressao ::= NUMERO
            | ID
            | TEXTO
            | expressao MAIS expressao
            | expressao MENOS expressao
            | expressao MULT expressao
            | expressao DIV expressao
            | expressao MENOR expressao
            | expressao MAIOR expressao
            | expressao IGUAL expressao
            | expressao DIFERENTE expressao ;